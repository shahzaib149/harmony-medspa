{
  "name": "harmony-med-spa-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:website": "next dev -p 3000",
    "dev:dashboard": "npm --prefix dashboard run dev -- -p 3001",
    "dev:platform": "concurrently --kill-others-on-fail --names website,dashboard \"npm run dev:website\" \"npm run dev:dashboard\"",
    "build": "next build --webpack",
    "build:dashboard": "npm --prefix dashboard run build",
    "build:all": "npm run build && npm run build:dashboard",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "^16.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.2",
    "typescript": "5.7.2"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
